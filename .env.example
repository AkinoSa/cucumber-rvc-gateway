# RVC 控制台网关配置示例
# 用法:cp .env.example .env,然后按注释修改;.env 不要提交到公开仓库。
# 所有路径都是【宿主机路径】;容器内部路径保持标准值,无需修改代码。

# ---- 端口与资源 ----
RVC_GATEWAY_PORT=3333
RVC_CPU_LIMIT=3
RVC_MEMORY_LIMIT=8g
RVC_MEMORY_SWAP_LIMIT=12g
RVC_OMP_THREADS=2

# ---- 模型目录(必填,只读挂载)----
RVC_WEIGHTS_DIR=/path/to/rvc/assets/weights
RVC_INDICES_DIR=/path/to/rvc/assets/indices
RVC_PYMSS_WEIGHTS_DIR=/path/to/rvc/assets/pymss_weights
RVC_HUBERT_DIR=/path/to/rvc/assets/hubert_base
RVC_RMVPE_DIR=/path/to/rvc/assets/rmvpe

# ---- 工作目录(必填,读写)----
RVC_WORK_DIR=/path/to/rvc/gateway_work

# ---- AstrBot 插件数据目录(必填,只读挂载)----
RVC_PLUGIN_DATA_DIR=/path/to/astrbot/data/plugin_data

# ---- 可选 ----
RVC_SEP_MODEL=3_HP-Vocal-UVR.pth
RVC_NETEASE_BASE=https://wyy.xhily.com
TZ=Asia/Shanghai
